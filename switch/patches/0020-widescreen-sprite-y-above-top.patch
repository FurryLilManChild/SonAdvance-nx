+// SonAdvance-nx: the original 8-bit OAM y cannot tell a sprite partly above
+// the top of the 240-line picture (y -32 stored as 224) from one near its
+// bottom (y 224). Where the game knows the full y it records the answer:
+// 1 = y as stored, 2 = stored y minus 256. 0 = unknown (the renderer's old
+// rule). The value rides in the free bits of the OAM entry's 4th halfword
+// while in gOamMallocBuffer and lands here, by OAM slot, in ProcessOamBuffers.
+u8 gSonAdvOamYWrap[OAM_ENTRY_COUNT];
+#define SONADV_OAM_Y_WRAP(fullY) ((((fullY) < 0) || ((fullY) >= 256)) ? 2 : 1)
+#define SONADV_SET_OAM_Y_WRAP(oam, fullY) ((oam)->split.integer = SONADV_OAM_Y_WRAP(fullY))
+#else
+#define SONADV_SET_OAM_Y_WRAP(oam, fullY)
+#endif
