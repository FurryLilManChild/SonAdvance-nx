+#define WS_SPEED(v)       (((v) * DISPLAY_WIDTH) / 240)
+#define WS_OFFSCREEN(x)   (((x) + WS_RIGHT) > 504 ? 504 : ((x) + WS_RIGHT))
+#else
+#define WS_RIGHT          0
+#define WS_DOWN           0
+#define WS_CELLS32        0
+#define WS_ROWS32         0
+#define WS_SPEED(v)       (v)
+#define WS_OFFSCREEN(x)   (x)
+#endif
