 // teardown is the one the game uses when a life is lost (HandleLifeLost);
 // GameStageStart then starts the act from its beginning, as the next-act path
 // (GoToNextLevel) does.
+// Super Sonic in normal acts. SA1's own Super Sonic exists only for the
+// final stage (The Moon), where he flies; it has no running, jumping or
+// rolling sprites. So this is the Genesis-style idea built from what the
+// game has: Sonic's own sprites with Super Sonic's palette (sprite palette
+// 11, same color layout as Sonic's palette 0), the invincibility item's
+// effect without its music or stars, and the speed shoes' effect without
+// the faster music. Both timers are refreshed every frame so they never run
+// out; turning the cheat off lets them run out normally a frame later.
+#define SUPER_SONIC_PALETTE 11
+#define SONIC_PALETTE       0
+#define SUPER_TIMER         2
+
+static bool8 sSuperApplied;
+
+bool32 SonAdv_SuperActive(void)
+{
+    return gSonAdvCheats.superSonic && IS_SINGLE_PLAYER && (gGameStageTask != NULL) && !IS_EXTRA_STAGE(gCurrentLevel)
+        && (gPlayer.character == CHARACTER_SONIC);
+}
+
+static void SetSonicPalette(s32 palette)
+{
+    for (int i = 0; i < 16; i++) {
+        GET_PALETTE_COLOR_OBJ(0, i) = gRefSpriteTables->palettes[palette * 16 + i];
+    }
+    gFlags |= FLAGS_UPDATE_SPRITE_PALETTES;
+}
+
+void SonAdv_StageFrame(void)
+{
+    Sprite *body = (gPlayer.spriteInfoBody != NULL) ? &gPlayer.spriteInfoBody->s : NULL;
+
+    if (SonAdv_SuperActive()) {
+        gPlayer.itemEffect |= (PLAYER_ITEM_EFFECT__INVINCIBILITY | PLAYER_ITEM_EFFECT__SPEED_UP);
+        gPlayer.timerInvincibility = SUPER_TIMER;
+        gPlayer.timerSpeedup = SUPER_TIMER;
+        if (body != NULL) {
+            // Keep the animations from loading Sonic's blue palette back in.
+            body->frameFlags |= SPRITE_FLAG_MASK_18;
+        }
+        SetSonicPalette(SUPER_SONIC_PALETTE);
+        sSuperApplied = TRUE;
+    } else if (sSuperApplied) {
+        sSuperApplied = FALSE;
+        if (body != NULL) {
+            body->frameFlags &= ~SPRITE_FLAG_MASK_18;
+        }
+        if (gPlayer.character == CHARACTER_SONIC) {
+            SetSonicPalette(SONIC_PALETTE);
+        }
+        // The timers (2) run out on their own next frame.
+    }
+}
