--- a/src/game/sa1/stage/player_super_sonic.c
+++ b/src/game/sa1/stage/player_super_sonic.c
@@ -61,7 +61,16 @@
     Sprite *s;
     s32 r3;
 
+#if !WIDESCREEN_HACK
     cam->minY = coll->pxHeight - 200;
+#else
+    // SonAdvance-nx: the camera may go no lower than the map's height less the
+    // picture's height. For the 240-line picture that is above pxHeight - 200,
+    // so the lower bound was past the upper one and the clamps in camera.c
+    // alternated between them every frame (sprites jumping 40 lines up and
+    // down). The camera stays at the map's bottom edge instead.
+    cam->minY = MIN(coll->pxHeight - 200, coll->pxHeight - DISPLAY_HEIGHT);
+#endif
     cam->maxX = 480;
     cam->shiftX = 64;
     cam->shiftY = 0;
--- a/src/game/shared/stage/camera.c
+++ b/src/game/shared/stage/camera.c
@@ -30,6 +30,20 @@
 
 #define BOSS_CAM_FRAME_DELTA_PIXELS 5
 
+// SonAdvance-nx: with the widescreen picture a camera range can be smaller
+// than the screen (lower bound past the upper one). CLAMP then gives a
+// different answer depending on where the camera came from, and two clamps
+// in one frame made it jump between both bounds every other frame (The Moon:
+// sprites 40 lines up, then down). Such a range is settled the same way every
+// time: centred across, bottom edge down.
+#if WIDESCREEN_HACK
+#define CAM_CLAMP_X(v, lo, hi) (((lo) > (hi)) ? (((lo) + (hi)) / 2) : CLAMP((v), (lo), (hi)))
+#define CAM_CLAMP_Y(v, lo, hi) (((lo) > (hi)) ? (hi) : CLAMP((v), (lo), (hi)))
+#else
+#define CAM_CLAMP_X(v, lo, hi) CLAMP((v), (lo), (hi))
+#define CAM_CLAMP_Y(v, lo, hi) CLAMP((v), (lo), (hi))
+#endif
+
 // NOTE:
 // unk8 is a regular integer in SA1, but Q_24_8 in SA2
 #if (GAME == GAME_SA1)
