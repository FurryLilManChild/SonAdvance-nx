@@ -0,0 +1,46 @@
+// SonAdvance-nx: port options and actions shared by the Switch build and the
+// host harness. See include/sonadv_port.h.
+#include "global.h"
+#include "core.h"
+#include "task.h"
+#include "lib/m4a/m4a.h"
+#include "game/globals.h"
+#include "game/shared/stage/stage.h"
+#include "sonadv_port.h"
+
+SonAdvCheats gSonAdvCheats;
+
+#if (GAME == GAME_SA1)
+void GameStageStart(void); // stage.c (declared in stage.h for SA2 only)
+#endif
+
+#if (GAME == GAME_SA1)
+bool32 SonAdv_CanRestartAct(void)
+{
+    return (gGameStageTask != NULL) && IS_SINGLE_PLAYER && !(gStageFlags & STAGE_FLAG__DEMO_RUNNING);
+}
+
+// Called between frames (from the platform's VBlankIntrWait, after the frame's
+// tasks ran), the same point a task-driven stage change takes effect. The
+// teardown is the one the game uses when a life is lost (HandleLifeLost);
+// GameStageStart then starts the act from its beginning, as the next-act path
+// (GoToNextLevel) does.
+void SonAdv_RestartAct(void)
+{
+    if (!SonAdv_CanRestartAct())
+        return;
+
+    gFlags &= ~(FLAGS_PAUSE_GAME | FLAGS_EXECUTE_HBLANK_COPY);
+    m4aMPlayAllStop();
+
+    TasksDestroyAll();
+    PAUSE_BACKGROUNDS_QUEUE();
+    gBgSpritesCount = 0;
+    PAUSE_GRAPHICS_QUEUE();
+
+    GameStageStart();
+}
+#else
+bool32 SonAdv_CanRestartAct(void) { return FALSE; }
+void SonAdv_RestartAct(void) { }
+#endif
