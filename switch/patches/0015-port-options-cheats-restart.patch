+// SonAdvance-nx: port options the game code reads (cheats) and port actions
+// (restart act). Set by the Switch port menu; the host harness sets them from
+// environment variables.
+#ifndef GUARD_SONADV_PORT_H
+#define GUARD_SONADV_PORT_H
+
+#include "global.h"
+#include "game/globals.h"
+
+typedef struct {
+    u8 infiniteLives; // a lost life is given back (single player)
+    u8 keepRings;     // getting hit knocks the player back but drops no rings
+    u8 noDamage;      // enemies and hazards that hit (not pits, lava, crushing, drowning) do nothing
+    u8 allZones;      // course select offers every zone, without changing the save
+} SonAdvCheats;
+
+extern SonAdvCheats gSonAdvCheats;
+
+// Infinite lives cheat: called just before the game takes a life away.
+static inline void SonAdv_GiveLifeBack(void)
+{
+    if (gSonAdvCheats.infiniteLives && IS_SINGLE_PLAYER && (gNumLives < 255)) {
+        gNumLives++;
+    }
+}
+
+// True while a single-player act is running (the port menu offers Restart act).
+bool32 SonAdv_CanRestartAct(void);
+// Back to the start of the current act: no checkpoint, 0 rings, timer reset, no life lost.
+void SonAdv_RestartAct(void);
+
+#endif
