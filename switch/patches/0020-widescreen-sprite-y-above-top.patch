+
+#if WIDESCREEN_HACK && !EXTENDED_OAM
+// SonAdvance-nx: see gSonAdvOamYWrap in sprite.c.
+extern "C" u8 gSonAdvOamYWrap[128];
+static inline s32 sonadv_obj_y(u32 slot, s32 y)
+{
+    u8 w = gSonAdvOamYWrap[slot];
+    if (w == 1)
+        return y;
+    if (w == 2)
+        return y - 256;
+    return (y > DISPLAY_HEIGHT) ? y - 256 : y;
+}
+#endif
