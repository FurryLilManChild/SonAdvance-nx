--- /dev/null
+++ b/include/sonadv_classic.h
@@ -0,0 +1,16 @@
+// SonAdvance-nx: included last by the game's non-stage screen files (menus,
+// intro, character select, special stage, ...). Those screens were laid out
+// for the GBA's 240x160 picture, so their code uses the original size and
+// centre; the port shows that 240x160 area centred with side borders while no
+// stage is running. Data sized by DISPLAY_* in shared headers was already
+// expanded above this point, so only the code below sees the original size.
+#if WIDESCREEN_HACK
+#undef DISPLAY_WIDTH
+#undef DISPLAY_HEIGHT
+#undef DISPLAY_CENTER_X
+#undef DISPLAY_CENTER_Y
+#define DISPLAY_WIDTH    240
+#define DISPLAY_HEIGHT   160
+#define DISPLAY_CENTER_X (DISPLAY_WIDTH / 2)
+#define DISPLAY_CENTER_Y (DISPLAY_HEIGHT / 2)
+#endif
